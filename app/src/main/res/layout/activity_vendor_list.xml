<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F7F7FB"
    android:padding="24dp">

    <!-- Heading -->
    <TextView
        android:id="@+id/vendorHeading"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Our Vendors"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#222222" />

    <!-- Subtitle -->
    <TextView
        android:id="@+id/vendorSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Find the perfect vendors for your event"
        android:textSize="14sp"
        android:textColor="#777777" />

    <!-- Loading -->
    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="12dp" />

    <!-- Scrollable Vendor List -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/vendorContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

    </ScrollView>

</LinearLayout>